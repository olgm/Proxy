# Copy this file to .env, which is gitignored, and fill in real values.
# Before running proxyctl: set -a; . ./.env; set +a
#
# The webhook variable names below are the ones topology.example.json's
# discord/feeds block names under webhook_env. topology.json is free to name
# different variables; whatever it names there is what proxyctl reads here.
# Each is a Discord webhook URL, which is a bearer credential like a password.

# Discord bot token, read by proxyctl at deploy time and carried to the bot's
# node; also read directly by proxybot if you run it by hand off-node.
DISCORD_BOT_TOKEN=

# Webhook URL for the sessions feed (proxyd: one line per login/logout).
DISCORD_SESSIONS_WEBHOOK=

# Webhook URL for the probe feed (probed: closed measurement windows).
DISCORD_PROBE_WEBHOOK=

# Webhook URL for the online feed (proxybot: the roster message).
DISCORD_ONLINE_WEBHOOK=

# Webhook URL for the status feed (proxybot: the status card and transitions).
DISCORD_STATUS_WEBHOOK=
